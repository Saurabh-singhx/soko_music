# ==============================================================================
# Soko Music Environment Variables Template
# Copy this file to .env and configure your local values.
# NEVER commit .env or sensitive credentials to version control.
# ==============================================================================

# Android Keystore Signing Configuration (Optional for local dev)
# If omitted, local builds will automatically generate an ephemeral dev keystore.
KEYSTORE_PATH=
KEYSTORE_PASSWORD=
KEYSTORE_ALIAS=

# ==============================================================================
# GitHub Repository Secrets Reference
# Add these at: https://github.com/<owner>/<repo>/settings/secrets/actions
# ==============================================================================
# GIST_TOKEN=<GitHub Personal Access Token with 'gist' scope>
# GIST_ID=04c5db7f1bed9206d1b858cd44bfb8eb
# KEYSTORE_BASE64=<Base64 encoded production release .keystore file>
# KEYSTORE_PASSWORD=<Production release keystore password>
# KEY_ALIAS=<Production release key alias>
